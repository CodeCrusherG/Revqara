# ─────────────────────────────────────────────────────────────────────────────
# Local-machine overrides for running the backend OUTSIDE Docker.
#
# The base .env uses Docker service hostnames (db, whatsapp-sim, host.docker.
# internal) and the in-container Postgres credentials. When you run uvicorn
# directly on your host, those names don't resolve — source this file AFTER
# .env to point everything at localhost and the host-published ports.
#
# Copy to .env.local (gitignored) and adjust if your ports/passwords differ:
#   cp .env.local.example .env.local
#
# See LOCAL_DEV.md for the full run procedure.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres — the cx-pg container publishes 5432 on host port 5434, and was
# created with password "secret" (the docker-compose internal value).
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_PASSWORD=secret

# WhatsApp simulator runs on the host at :9000 (not the docker service name).
WA_SIM_URL=http://localhost:9000

# Ollama runs on the host directly (not via host.docker.internal).
OLLAMA_BASE_URL=http://localhost:11434
