# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=campaignx
POSTGRES_PASSWORD=campaignx_secret
POSTGRES_DB=campaignx_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Ollama LLM ───────────────────────────────────────────────
# Ollama must be running on the host machine.
# Run: ollama run glm4:latest  (or whichever model you prefer)
# host.docker.internal lets the Docker container reach the host Ollama server.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=glm-5:cloud

# ─── Auth ─────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. Change this in production.
JWT_SECRET=campaignx_dev_jwt_secret_change_me
JWT_EXPIRE_HOURS=168

# ─── WhatsApp (pywa client → offline simulator) ───────────────
# Base URL of the WhatsApp Cloud API Simulator. In docker-compose this is the
# `whatsapp-sim` service; locally it is http://localhost:9000.
WA_SIM_URL=http://whatsapp-sim:9000
WA_API_VERSION=25.0

# Synthetic business identity (no real Meta account is used).
WA_PHONE_NUMBER_ID=1144783542054931
WA_TOKEN=SIMULATED_TOKEN
WA_APP_ID=000000000000000

# App secret used to sign/verify webhook payloads — MUST match the simulator's
# WA_APP_SECRET so x-hub-signature-256 validates.
WA_APP_SECRET=campaignx_sim_secret
WA_VERIFY_TOKEN=campaignx_verify

# Recipients actually messaged per variant (sample size for the broadcast).
WA_MAX_RECIPIENTS=40
# Seconds to wait for read/click webhooks before the Analyst reads the report.
WA_SETTLE_TIMEOUT=8
WA_CLICK_BUFFER=1.2
