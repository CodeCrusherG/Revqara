# ─── WhatsApp Cloud API Simulator ────────────────────────────────────────────
# The business webhook the simulator delivers inbound events to.
# In docker-compose this is the backend service; locally it is localhost:8000.
WA_WEBHOOK_URL=http://localhost:8000/api/whatsapp/webhook

# Meta App Secret — MUST be identical to the backend's WA_APP_SECRET so that the
# x-hub-signature-256 signature validates on the pywa side.
WA_APP_SECRET=campaignx_sim_secret

# Business identity echoed in webhook envelopes (synthetic; no real account).
WA_PHONE_NUMBER_ID=1144783542054931
WA_DISPLAY_NUMBER=918091715374
WA_WABA_ID=1543168170860436

# ─── Engagement tuning (optional) ─────────────────────────────────────────────
# Delays (seconds) before each webhook fires.
WA_DELAY_DELIVERED=0.15
WA_DELAY_READ=0.45
WA_DELAY_CLICK=0.8
# Base rates before content-sensitive adjustments.
WA_BASE_DELIVERED_RATE=0.98
WA_BASE_READ_RATE=0.55
WA_BASE_CLICK_RATE=0.22
